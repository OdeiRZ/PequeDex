APP_NAME=PequeDex
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Dónde se guardan las fotos de los hitos: "public" en local (servido vía
# storage:link); en producción, "s3" apuntando a Cloudflare R2 - el
# sistema de archivos de Render es efímero, así que un disco local ahí
# perdería las fotos en cada redeploy.
MILESTONES_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# `log` escribe el correo de restablecer contraseña en storage/logs en
# vez de enviarlo - vale para desarrollo local, pero producción necesita
# un mailer real para que el enlace llegue a alguien de verdad. Se usa
# el remitente onboarding@resend.dev de Resend (sin dominio propio
# verificado todavía): crea una cuenta en https://resend.com y pon
# MAIL_MAILER=resend, RESEND_API_KEY=<tu key>.
RESEND_API_KEY=

# Solo hacen falta en producción (MILESTONES_DISK=s3), configurados contra
# un bucket de Cloudflare R2, no AWS real - R2 es compatible con la API S3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# Monitorizacion de errores en produccion (sentry.io, plan gratuito) - sin
# DSN, el SDK no hace nada (ni en local ni en tests). traces_sample_rate no
# se pone aqui a proposito - config/sentry.php ya lo deja en null (sin
# tracing de rendimiento) salvo que SENTRY_TRACES_SAMPLE_RATE se defina
# explicitamente, y no hace falta gastar cuota en eso solo para errores.
SENTRY_LARAVEL_DSN=
